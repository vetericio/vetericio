# ORICSTUDIO INDEPENDENTE — modelo sem nenhum segredo real.
# Não usar o URL/projeto do Gestor 2.0. Não commitar um arquivo .env preenchido.
ORICSTUDIO_INSTANCE_ID=oricstudio
APP_BASE_URL=https://seu-oricstudio.example.com
ORICSTUDIO_URL=https://seu-oricstudio.example.com

# Banco Supabase da nova aplicação OricStudio, jamais da instalação Gestor 2.0.
VITE_SUPABASE_URL=https://seu-projeto-oricstudio.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_somente_exemplo
VITE_SUPABASE_PROJECT_ID=seu-projeto-oricstudio
SUPABASE_URL=https://seu-projeto-oricstudio.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_somente_exemplo
SUPABASE_PROJECT_ID=seu-projeto-oricstudio

# Servidor — definir na infraestrutura, nunca colocar valores reais no Git.
SUPABASE_SERVICE_ROLE_KEY=DEFINIR_SOMENTE_NO_SERVIDOR
TOKEN_ENCRYPTION_KEY=BASE64_ALEATORIA_32_BYTES_NOVA

# Login direto pelo Instagram (principal, sem página Facebook).
IG_APP_ID=NUMERO_DO_APP_INSTAGRAM
IG_APP_SECRET=DEFINIR_SOMENTE_NO_SERVIDOR

# Facebook Login for Business (alternativo; app independente do Gestor).
META_APP_ID=NUMERO_DO_APP_META
META_APP_SECRET=DEFINIR_SOMENTE_NO_SERVIDOR
META_LOGIN_CONFIG_ID=NUMERO_DA_CONFIGURACAO
META_GRAPH_VERSION=v26.0

# Job secrets do ORICSTUDIO, exclusivos desta instalação (Vault/Supabase).
# ORICSTUDIO_CRON_SECRET=DEFINIR_SOMENTE_NO_SERVIDOR
