# Variáveis do Gestor de Contas Instagram (valores ilustrativos — nunca coloque valores reais aqui).
#
# Públicas (o Lovable gera e versiona em .env; podem ir para o navegador):
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
VITE_SUPABASE_PROJECT_ID=seu-projeto
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_PROJECT_ID=seu-projeto

# Secretas do servidor (configure em Lovable Cloud → Secrets; NUNCA no código nem no frontend):
# ID do app no Meta for Developers (Configurações do app → Básico)
META_APP_ID=000000000000000
# Chave secreta do app (mesma tela, "Mostrar")
META_APP_SECRET=troque-pela-chave-secreta
# ID da configuração do Login do Facebook para Empresas (Login do Facebook para Empresas → Configurações)
META_LOGIN_CONFIG_ID=000000000000000
# Versão da Graph API (opcional; padrão v24.0)
META_GRAPH_VERSION=v24.0
# Chave AES-256-GCM dos tokens: 32 bytes aleatórios em base64 (gere a sua; nunca reutilize)
TOKEN_ENCRYPTION_KEY=base64-de-32-bytes-aleatorios
# Endereço publicado do app, sem barra no final
APP_BASE_URL=https://seu-app.lovable.app

# Gerenciadas pelo Lovable (não edite): SUPABASE_SERVICE_ROLE_KEY, LOVABLE_CRON_SECRET, LOVABLE_API_KEY
#
# Assistente local (opcional): URL do sistema; a chave fica em %USERPROFILE%\.gestor-instagram\chave-assistente
GESTOR_URL=https://seu-app.lovable.app
