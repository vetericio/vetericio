SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Google Drive é a camada persistente de dados e documentos do ORICSE.
ORICSE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Alternativa à conta de serviço:
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Meta Instagram API with Unified Login (Cloudflare Worker only)
ORICSTUDIO_META_CLIENT_ID=
ORICSTUDIO_META_CLIENT_SECRET=
ORICSTUDIO_META_CONFIG_ID=
ORICSTUDIO_META_REDIRECT_URI=https://oricse.vetericio.workers.dev/api/oricstudio/meta/callback
ORICSTUDIO_META_ENCRYPTION_KEY=
